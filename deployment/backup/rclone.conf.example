# /etc/chronochunk/rclone.conf on the VM, mode 600, owned by root. No real values here.
# Build the two obscured values with `rclone obscure <password>` and `rclone obscure <salt>`.
# The plain password and salt are kept off the VM too (see README, "Backups off the server"),
# because without them the backups cannot be decrypted.

[r2]
type = s3
provider = Cloudflare
access_key_id = <R2 token access key id, Object Read & Write on chronochunk-backups only>
secret_access_key = <R2 token secret>
endpoint = https://<cloudflare account id>.r2.cloudflarestorage.com
acl = private
# A bucket-scoped token cannot list buckets
no_check_bucket = true

[backup]
type = crypt
remote = r2:chronochunk-backups/chronochunk
password = <obscured password>
password2 = <obscured salt>
filename_encryption = standard
