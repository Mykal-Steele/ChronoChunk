# Compile on the Python the image runs (3.15): discord.py only asks for audioop-lts on 3.13 and later.
#   docker run --rm -v "$PWD":/work -w /work python:3.15-slim sh -c \
#     "pip install -q pip-tools && pip-compile -q --strip-extras requirements.in"
