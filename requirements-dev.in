# What the tests and the checks in CI need on top of requirements.txt. requirements-dev.txt is built from this file:
#   docker run --rm -v "$PWD":/work -w /work python:3.12-slim sh -c \
#     "pip install -q pip-tools && pip-compile -q --strip-extras requirements-dev.in"
-c requirements.txt
